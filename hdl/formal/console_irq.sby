# The bus and interrupt ports of the console's receive interrupt
# (formal_console_irq.vhd). "prove" proves the checks of the ports for
# every cycle by k-induction, "bmc" all the checks for 16 cycles from
# reset, and "cover" reaches each cover statement.

[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 6
bmc: mode bmc
bmc: depth 16
cover: mode cover
cover: depth 12

[engines]
smtbmc yices

[script]
plugin -i ghdl
prove: ghdl --std=08 -fpsl -gG_SHADOW=false console_irq.vhd wb_slave_check.vhd formal_console_irq.vhd -e formal_console_irq
bmc: ghdl --std=08 -fpsl console_irq.vhd wb_slave_check.vhd formal_console_irq.vhd -e formal_console_irq
cover: ghdl --std=08 -fpsl console_irq.vhd wb_slave_check.vhd formal_console_irq.vhd -e formal_console_irq
prep -top formal_console_irq

[files]
../src/console_irq.vhd
wb_slave_check.vhd
formal_console_irq.vhd
