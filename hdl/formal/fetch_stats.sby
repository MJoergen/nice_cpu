# The fetch statistics (formal_fetch_stats.vhd, and the properties under
# G_FORMAL in fetch_stats.vhd). "prove" proves the assertions for every
# cycle by k-induction, and "cover" reaches each cover statement.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 1
cover: mode cover
cover: depth 20

[engines]
prove: smtbmc boolector
cover: smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd fetch_stats.vhd wb_slave_check.vhd formal_fetch_stats.vhd -e formal_fetch_stats
prep -top formal_fetch_stats

[files]
../src/nice_pkg.vhd
../src/trace_pkg.vhd
../src/pipe_pkg.vhd
../src/fetch_stats.vhd
wb_slave_check.vhd
formal_fetch_stats.vhd
