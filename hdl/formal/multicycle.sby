# The bus and interrupt ports of the multi-cycle core (formal_multicycle.vhd).
# "prove" proves the assertions for every cycle by k-induction, and "cover"
# reaches each cover statement.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl trace_pkg.vhd multicycle.vhd wb_master_check.vhd handshake_check.vhd formal_multicycle.vhd -e formal_multicycle
prep -top formal_multicycle

[files]
../src/trace_pkg.vhd
../src/multicycle.vhd
wb_master_check.vhd
handshake_check.vhd
formal_multicycle.vhd
