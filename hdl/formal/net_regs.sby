# The bus port and the addresses of the network station
# (formal_net_regs.vhd). "prove" proves the assertions for every cycle by
# k-induction, and "cover" reaches each cover statement.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 10
cover: mode cover
cover: depth 20

[engines]
smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl net_regs.vhd wb_slave_check.vhd formal_net_regs.vhd -e formal_net_regs
prep -top formal_net_regs

[files]
../src/net_regs.vhd
wb_slave_check.vhd
formal_net_regs.vhd
