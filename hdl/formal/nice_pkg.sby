# The functions of src/nice_pkg.vhd and the block compares of
# src/pipe_pkg.vhd, against ISA.md and MICROARCH.md for every input
# (formal_nice_pkg.vhd). They are combinational, so "prove" at depth 1
# covers every value, and "cover" shows the large counts and the ends of
# the ranges that the assertions see. The table of mod33 is mapped to
# logic, so that nothing here is state: as a memory, its contents would be
# free in the induction step.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 1
cover: mode cover
cover: depth 1

[engines]
smtbmc boolector

[script]
plugin -i ghdl
ghdl --std=08 -fpsl nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd formal_nice_pkg.vhd -e formal_nice_pkg
prep -top formal_nice_pkg
memory_map

[files]
../src/nice_pkg.vhd
../src/trace_pkg.vhd
../src/pipe_pkg.vhd
formal_nice_pkg.vhd
