# DECODE of the pipelined core (formal_pipe_decode.vhd, and the
# properties under G_FORMAL in pipe_decode.vhd). "prove" proves the
# assertions for every cycle by k-induction, and "cover" reaches each
# cover statement.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 2
cover: mode cover
cover: depth 12

[engines]
prove: smtbmc yices
cover: smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd pipe_decode.vhd formal_pipe_decode.vhd -e formal_pipe_decode
prep -top formal_pipe_decode

[files]
../src/nice_pkg.vhd
../src/trace_pkg.vhd
../src/pipe_pkg.vhd
../src/pipe_decode.vhd
formal_pipe_decode.vhd
