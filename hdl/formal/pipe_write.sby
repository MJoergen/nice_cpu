# WRITE of the pipelined core (formal_pipe_write.vhd). "prove" proves the
# assertions for every cycle by k-induction, and "cover" reaches each
# cover statement. The properties are about the halt only: the rest of
# WRITE is ISA semantics, which the trace diff checks better.

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 2
cover: mode cover
cover: depth 20

[engines]
prove: smtbmc yices
cover: smtbmc yices

[script]
plugin -i ghdl
ghdl --std=08 -fpsl nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd pipe_write.vhd formal_pipe_write.vhd -e formal_pipe_write
prep -top formal_pipe_write

[files]
../src/nice_pkg.vhd
../src/trace_pkg.vhd
../src/pipe_pkg.vhd
../src/pipe_write.vhd
formal_pipe_write.vhd
