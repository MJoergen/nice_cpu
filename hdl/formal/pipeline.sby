# The bus and interrupt ports of the pipelined core, and its own
# invariants (formal_pipeline.vhd). "bmc" checks the assertions for the
# first 12 cycles after reset, for every program and every bus, and
# "cover" reaches each cover statement. 12 cycles hold an interrupt entry,
# a first store, a halt, and the first step after a pause, which the
# covers show. Each further cycle costs many times more.
#
# ABC refuses the undefined bits that a read out of an index's range
# gives, a case the simulation never reaches, so the bmc task makes them
# free in every cycle.
#
# The bmc task ties reg_we_i to 0 (G_REG_WRITES), since a free register
# write took it from 3 minutes to 29, even with the write allowed only
# while paused. So the bmc task checks that the registers of a paused
# core do not change at all.
# The cover task keeps the write, while paused and with pause_i at 1, and
# reaches a step after it. formal_pipe_write proves the write itself for
# every cycle.

[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 12
cover: mode cover
cover: depth 12

[engines]
bmc: abc bmc3
cover: smtbmc yices

[script]
plugin -i ghdl
bmc: ghdl --std=08 -fpsl -gG_REG_WRITES=false nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd pipe_fetch.vhd pipe_decode.vhd pipe_prepare.vhd pipe_dbus.vhd pipe_write.vhd pipeline.vhd wb_master_check.vhd handshake_check.vhd core_check.vhd formal_pipeline.vhd -e formal_pipeline
cover: ghdl --std=08 -fpsl nice_pkg.vhd trace_pkg.vhd pipe_pkg.vhd pipe_fetch.vhd pipe_decode.vhd pipe_prepare.vhd pipe_dbus.vhd pipe_write.vhd pipeline.vhd wb_master_check.vhd handshake_check.vhd core_check.vhd formal_pipeline.vhd -e formal_pipeline
prep -top formal_pipeline
bmc: techmap
bmc: setundef -anyseq

[files]
../src/nice_pkg.vhd
../src/trace_pkg.vhd
../src/pipe_pkg.vhd
../src/pipe_fetch.vhd
../src/pipe_decode.vhd
../src/pipe_prepare.vhd
../src/pipe_dbus.vhd
../src/pipe_write.vhd
../src/pipeline.vhd
wb_master_check.vhd
handshake_check.vhd
core_check.vhd
formal_pipeline.vhd
