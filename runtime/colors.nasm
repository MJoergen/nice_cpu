; The colors of a screen word (DEVICES.md §1.1), as .EQU names: NICE_FG_* in
; bits 19..8, the foreground, and NICE_BG_* in bits 31..20, the background. It
; has no code, and a program joins it with cat, before or after itself. A
; color is a foreground and a background added, as in NICE_FG_YELLOW +
; NICE_BG_BLUE, and a color left out is black. The character goes in bits
; 7..0. nice.h, nice.zig, and nice.rs have the same colors.

NICE_FG_BLACK   .EQU    0x00000000
NICE_FG_RED     .EQU    0x000F0000
NICE_FG_GREEN   .EQU    0x0000F000
NICE_FG_YELLOW  .EQU    0x000FF000
NICE_FG_BLUE    .EQU    0x00000F00
NICE_FG_MAGENTA .EQU    0x000F0F00
NICE_FG_CYAN    .EQU    0x0000FF00
NICE_FG_WHITE   .EQU    0x000FFF00
NICE_FG_GRAY    .EQU    0x00088800
NICE_FG_LIGHT_GRAY .EQU 0x000CCC00
NICE_FG_LIGHT_RED .EQU  0x000F6600
NICE_FG_LIGHT_GREEN .EQU 0x0008E800
NICE_FG_LIGHT_BLUE .EQU 0x0000DF00
NICE_FG_NAVY    .EQU    0x00000A00
NICE_FG_DARK_BLUE .EQU  0x00003600
NICE_BG_BLACK   .EQU    0x00000000
NICE_BG_RED     .EQU    0xF0000000
NICE_BG_GREEN   .EQU    0x0F000000
NICE_BG_YELLOW  .EQU    0xFF000000
NICE_BG_BLUE    .EQU    0x00F00000
NICE_BG_MAGENTA .EQU    0xF0F00000
NICE_BG_CYAN    .EQU    0x0FF00000
NICE_BG_WHITE   .EQU    0xFFF00000
NICE_BG_GRAY    .EQU    0x88800000
NICE_BG_LIGHT_GRAY .EQU 0xCCC00000
NICE_BG_LIGHT_RED .EQU  0xF6600000
NICE_BG_LIGHT_GREEN .EQU 0x8E800000
NICE_BG_LIGHT_BLUE .EQU 0x0DF00000
NICE_BG_NAVY    .EQU    0x00A00000
NICE_BG_DARK_BLUE .EQU  0x03600000
